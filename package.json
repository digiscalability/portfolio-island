{
  "name": "digiscalability-life-island",
  "version": "1.0.0",
  "description": "An immersive 3D interactive experience - DigiScalability Life Island",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:debug": "vite --host 0.0.0.0 --debug",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "rm -rf dist node_modules/.vite .tsbuildinfo",
    "clean:all": "rm -rf dist node_modules node_modules/.vite .tsbuildinfo package-lock.json",
    "multi-dev": "concurrently \"npm run dev\" \"echo 'Ready for additional projects'\"",
    "lint": "eslint . --ext .ts --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier \"**/*.{ts,tsx,js,json,css}\" --write",
    "format:check": "prettier \"**/*.{ts,tsx,js,json,css}\" --check",
    "format:markdown": "npx markdownlint-cli2 --fix '**/*.md' '!node_modules/**' '!**/node_modules/**'",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "precommit": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "@notionhq/client": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "happy-dom": "^15.11.7",
    "markdownlint-cli": "^0.44.0",
    "markdownlint-cli2": "^0.17.2",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9",
    "ws": "^8.21.1"
  },
  "private": true
}
