rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is owner
    function isOwner() {
      return request.auth != null && request.auth.uid == 'ZNrmHgQcluNjOVl9pActQ4G1T002';
    }

    // Users collection
    match /users/{userId} {
      allow read: if true; // Public read
      allow write: if request.auth.uid == userId || isOwner();
    }

    // Islands/Zones collection
    match /islands/{islandId} {
      allow read: if true; // Public read
      allow write: if isOwner(); // Only owner can modify

      match /zones/{zoneId} {
        allow read: if true;
        allow write: if isOwner();
      }
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow read: if isOwner(); // Only owner can read feedback
      allow create: if true; // Anyone can submit feedback
      allow update, delete: if isOwner();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isOwner() || (request.auth != null && resource.data.email == request.auth.token.email);
      allow create: if true; // Anyone can create appointments
      allow update, delete: if isOwner();
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isOwner();
      allow create: if true; // Anyone can create conversations
      allow update, delete: if isOwner();
    }

    // Visitors collection
    match /visitors/{visitorId} {
      allow read: if isOwner();
      allow create: if true;
      allow update: if request.auth.uid == visitorId || isOwner();
      allow delete: if isOwner();
    }
  }
}

