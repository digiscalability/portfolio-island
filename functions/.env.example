# Config for the onLeadCreated email function (functions/src/index.ts).
# Copy this file to functions/.env and fill in real values. The .env file is
# gitignored. The SMTP PASSWORD is NOT here — it lives in Secret Manager:
#   firebase functions:secrets:set SMTP_PASSWORD --project life-island --account digiscalability@gmail.com
#
# ── Default: Gmail app password (zero new accounts) ──────────────────────────
# Enable 2-Step Verification on the sending Google account, then create an app
# password at https://myaccount.google.com/apppasswords and store it as the
# SMTP_PASSWORD secret (command above). Gmail forces From = the authenticated
# account, so LEAD_FROM must be that same Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=abba7254@gmail.com
LEAD_FROM=abba7254@gmail.com
LEAD_TO=abba7254@gmail.com

# ── Switch to a provider later — env-only, NO code change ────────────────────
# Resend (send as leads@digiscalability.com; verify the domain in Resend first):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   LEAD_FROM=DigiScalability Leads <leads@digiscalability.com>
#   LEAD_TO=admin@digiscalability.com
#   then: firebase functions:secrets:set SMTP_PASSWORD  (paste the re_... API key)
#
# SendGrid: SMTP_HOST=smtp.sendgrid.net  SMTP_USER=apikey  (secret = the API key)
# AWS SES:  SMTP_HOST=email-smtp.<region>.amazonaws.com  (SES SMTP credentials)
#
# ── Recommended: alert if the email channel breaks ──────────────────────────
# The email IS the lead notification, so if it fails (revoked app password, bad
# SMTP config, outage) leads silently pile up in RTDB with no signal. Add a
# push alert on the function's failure log so you find out immediately:
#   GCP console → Logging → create a log-based metric matching
#     resource.type="cloud_run_revision" AND severity=ERROR AND textPayload:"ALERT lead-email-failed"
#   then Monitoring → Alerting → policy on that metric > 0, notify your email/Slack.
# (Leads always persist under leads/island and can be recovered from the console.)
