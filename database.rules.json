{
  "rules": {
    "presence": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name', 'p', 'q', 't'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "hat": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "p": { "$i": { ".validate": "newData.isNumber()" } },
          "q": { "$i": { ".validate": "newData.isNumber()" } },
          "veh": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "vehIdx": { ".validate": "newData.isNumber()" },
          "vp": { "$i": { ".validate": "newData.isNumber()" } },
          "vq": { "$i": { ".validate": "newData.isNumber()" } },
          "t": { ".validate": "newData.isNumber()" },
          "wave": { ".validate": "newData.isNumber()" },
          "founder": { ".validate": "newData.isBoolean()" },
          "pose": { ".validate": "newData.isNumber()" },
          "cols": { "$part": { ".validate": "newData.isNumber()" } },
          "$other": { ".validate": false }
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['t'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "coins": { ".validate": "newData.isNumber() && newData.val() >= 0" }
      }
    },
    "chat": {
      "island": {
        ".read": "auth != null",
        "$entry": {
          ".write": "auth != null && (newData.child('id').val() === auth.uid || (!newData.exists() && data.child('id').val() === auth.uid))",
          ".validate": "newData.hasChildren(['id', 't'])",
          "text": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "audio": { ".validate": "newData.isString() && newData.val().length <= 60000" },
          "dur": { ".validate": "newData.isNumber()" },
          "id": { ".validate": "newData.isString()" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "voice": {
      "island": {
        ".read": "auth != null",
        "$entry": {
          ".write": "auth != null && (newData.child('id').val() === auth.uid || (!newData.exists() && data.child('id').val() === auth.uid))",
          ".validate": "newData.hasChildren(['id', 'audio', 't'])",
          "audio": { ".validate": "newData.isString() && newData.val().length <= 60000" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "dur": { ".validate": "newData.isNumber()" },
          "id": { ".validate": "newData.isString()" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "leaderboard": {
      "island": {
        ".read": "auth != null",
        "$circuit": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['name', 'timeMs', 't'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "timeMs": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "t": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "guestbook": {
      "island": {
        ".read": "auth != null",
        "$entry": {
          ".write": "auth != null && (newData.child('id').val() === auth.uid || (!newData.exists() && data.child('id').val() === auth.uid))",
          ".validate": "newData.hasChildren(['id', 'name', 'msg', 't'])",
          "id": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "msg": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "leads": {
      "island": {
        "$entry": {
          ".write": "auth != null && newData.exists() && newData.child('id').val() === auth.uid",
          ".validate": "newData.hasChildren(['id', 'email', 't'])",
          "id": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "message": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "ctx": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "world": {
      "island": {
        ".read": "auth != null",
        ".write": false
      }
    }
  }
}
