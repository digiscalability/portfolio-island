{
  "rules": {
    "presence": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name', 'p', 'q', 't']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('p').hasChildren() && newData.child('q').hasChildren()"
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['t'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "coins": { ".validate": "newData.isNumber() && newData.val() >= 0" }
      }
    },
    "chat": {
      "island": {
        "$entry": {
          ".read": "auth != null",
          ".write": "auth != null && newData.child('id').val() === auth.uid",
          "text": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "id":   { ".validate": "newData.isString()" },
          "t":    { ".validate": "newData.isNumber()" }
        }
      }
    },
    "voice": {
      "island": {
        "$entry": {
          ".read": "auth != null",
          ".write": "auth != null && newData.child('id').val() === auth.uid",
          "audio": { ".validate": "newData.isString() && newData.val().length <= 60000" },
          "id":    { ".validate": "newData.isString()" },
          "t":     { ".validate": "newData.isNumber()" }
        }
      }
    }
  }
}
